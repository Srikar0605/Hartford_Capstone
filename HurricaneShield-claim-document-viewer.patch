+  /** Document currently open in the preview panel. */
+  readonly previewDocument = signal<ClaimDocumentResponse | null>(null);
+  /** Object URL of the downloaded file; revoked when the panel closes. */
+  readonly previewUrl = signal<string | null>(null);
+  readonly previewLoading = signal(false);
+  readonly previewError = signal<string | null>(null);
+  /** PDFs render in an iframe, which needs an explicitly trusted resource URL. */
+  readonly previewResourceUrl = computed<SafeResourceUrl | null>(() => {
+    const url = this.previewUrl();
+    return url ? this.sanitizer.bypassSecurityTrustResourceUrl(url) : null;
+  });
+  readonly previewKind = computed<'image' | 'pdf' | 'other' | null>(() => {
+    const type = (this.previewDocument()?.contentType ?? '').toLowerCase();
+    if (!this.previewDocument()) return null;
+    if (type.startsWith('image/')) return 'image';
+    if (type === 'application/pdf') return 'pdf';
+    return 'other';
+  });
+
+  /** Fetches an uploaded document with the user's token and opens it in the preview panel. */
+  viewDocument(document: ClaimDocumentResponse): void {
+    this.closeDocumentPreview();
+    this.previewDocument.set(document);
+    this.previewLoading.set(true);
+    this.claimsService
+      .downloadDocument(document.claimId, document.documentId)
+      .pipe(takeUntil(this.destroy$))
+      .subscribe({
+        next: (blob) => {
+          // Re-type the blob with the stored content type so the browser renders it inline.
+          const typed = new Blob([blob], { type: document.contentType || blob.type });
+          this.previewUrl.set(URL.createObjectURL(typed));
+          this.previewLoading.set(false);
+        },
+        error: (error: unknown) => {
+          this.previewLoading.set(false);
+          this.previewError.set(
+            error instanceof ApiClientError
+              ? error.message
+              : 'The document could not be loaded. Try again in a moment.',
+          );
+        },
+      });
+  }
+
+  /** Saves the open document to the user's device under its original file name. */
+  saveDocument(): void {
+    const url = this.previewUrl();
+    const document = this.previewDocument();
+    if (!url || !document) return;
+    const link = this.doc.createElement('a');
+    link.href = url;
+    link.download = document.fileName;
+    link.click();
+  }
+
+  closeDocumentPreview(): void {
+    const url = this.previewUrl();
+    if (url) URL.revokeObjectURL(url);
+    this.previewUrl.set(null);
+    this.previewDocument.set(null);
+    this.previewLoading.set(false);
+    this.previewError.set(null);
+  }
